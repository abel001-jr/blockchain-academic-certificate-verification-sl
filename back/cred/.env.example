# ── Django ────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────
DB_NAME=credence_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── IPFS / Pinata ─────────────────────────────────────────────
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-key
PINATA_GATEWAY=https://gateway.pinata.cloud
# Generate a unique 32-byte key (64 hex characters) and keep it secret/off-repo.
CREDENTIAL_DOCUMENT_ENCRYPTION_KEY=replace-with-64-hex-characters

# ── Blockchain ────────────────────────────────────────────────
ETH_RPC_URL=http://127.0.0.1:8545
CERTIFICATE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ISSUER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ── Email / Brevo SMTP (optional — set EMAIL_ENABLED=True to send) ─
# EMAIL_ENABLED=False skips send_mail; API returns temp_password once for manual share.
EMAIL_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=CREDENCE <your-verified-sender@example.com>
EMAIL_ALWAYS_RETURN_TEMP_PASSWORD=True
FRONTEND_URL=http://localhost:3000

# ── WhatsApp / Twilio ─────────────────────────────────────────────────────
# Set WHATSAPP_ENABLED=True to send issuance notifications to students.
# Get credentials at https://console.twilio.com/
# Sandbox FROM number (free, no approval): whatsapp:+14155238886
# Production: set to your approved Twilio WhatsApp sender number.
WHATSAPP_ENABLED=False
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
STUDENT_INVITE_TTL_HOURS=24
CONSENT_REQUEST_TTL_MINUTES=30

# ── hCaptcha (public verify endpoint) ─────────────────────────────────────
# Get keys at https://dashboard.hcaptcha.com/
# Set HCAPTCHA_ENABLED=True in production to require a captcha token from
# anonymous callers on GET /api/verify/<id>/.
# Authenticated callers (logged-in dashboard users) are always exempt.
HCAPTCHA_ENABLED=False
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
# Frontend also needs the site key (public, safe to commit):
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# ── Google OAuth ───────────────────────────────────────────────────────────
# Web client ID from Google Cloud Console (Credence-Web.json)
# Used by POST /api/auth/google/ to verify mobile app ID tokens.
GOOGLE_CLIENT_ID=335667631038-vouui7i0uqde3v04jcs2lb1l9sk9h0pr.apps.googleusercontent.com
