# ── Django ────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────
DB_NAME=credence_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── IPFS / Pinata ─────────────────────────────────────────────
PINATA_API_KEY=your-pinata-api-key
PINATA_JWT=
# Free plan: 1 GB. Usage is fetched from Pinata; the quota is configured here.
PINATA_STORAGE_QUOTA_BYTES=1000000000
PINATA_SECRET_API_KEY=your-pinata-secret-key
PINATA_GATEWAY=https://gateway.pinata.cloud
# Generate a unique 32-byte key (64 hex characters) and keep it secret/off-repo.
CREDENTIAL_DOCUMENT_ENCRYPTION_KEY=replace-with-64-hex-characters

# ── Blockchain ────────────────────────────────────────────────
# These only seed the ChainConfig singleton (institutions.models.ChainConfig) the
# first time it is read. After that, Settings → Blockchain in the dashboard is the
# source of truth and these are ignored — edit them only to set a new install's
# starting point, not to reconfigure a running deployment.
ETH_RPC_URL=http://127.0.0.1:8545
ETH_CHAIN_ID=31337
CERTIFICATE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ISSUER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Optional. The wallet expected to own IssuerRegistry. If set, the dashboard warns
# when the connected account is not the contract's owner. Can also be set in the UI.
# EXPECTED_REGISTRY_OWNER=0x0000000000000000000000000000000000000000

# ── Email / Brevo SMTP (optional — set EMAIL_ENABLED=True to send) ─
# EMAIL_ENABLED=False skips send_mail; API returns temp_password once for manual share.
EMAIL_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=Intelligent Academic Credentialing <your-verified-sender@example.com>
EMAIL_ALWAYS_RETURN_TEMP_PASSWORD=True
FRONTEND_URL=http://localhost:3000

# ── WhatsApp / Twilio ─────────────────────────────────────────────────────
# Set WHATSAPP_ENABLED=True to send issuance notifications to students.
# Get credentials at https://console.twilio.com/
# Sandbox FROM number (free, no approval): whatsapp:+14155238886
# Production: set to your approved Twilio WhatsApp sender number.
WHATSAPP_ENABLED=False
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional when Tesseract is not on PATH. Windows example:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
STUDENT_INVITE_TTL_HOURS=24
CONSENT_REQUEST_TTL_MINUTES=30

# ── hCaptcha (public verify endpoint) ─────────────────────────────────────
# Get keys at https://dashboard.hcaptcha.com/
# Set HCAPTCHA_ENABLED=True in production to require a captcha token from
# anonymous callers on GET /api/verify/<id>/.
# Authenticated callers (logged-in dashboard users) are always exempt.
HCAPTCHA_ENABLED=False
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
# Frontend also needs the site key (public, safe to commit):
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# ── Google OAuth ───────────────────────────────────────────────────────────
# Web client ID from Google Cloud Console (Credence-Web.json)
# Used by POST /api/auth/google/ to verify mobile app ID tokens.
GOOGLE_CLIENT_ID=

# Optional backend-only template assistance
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Image comparisons use a separate vision model and the same API key.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
## Browser push: run `python manage.py configure_push` to generate a stable pair.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.edu
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com

# Set false only if the environment proxy blocks gateway requests.
IPFS_TRUST_ENV=true
IPFS_FALLBACK_GATEWAYS=https://ipfs.io,https://dweb.link

# Certificate field suggestions: Groq first, Gemini fallback (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
TEMPLATE_AI_RATE=5/min

# Additional Google OAuth audiences (Android/iOS client IDs), comma separated.
GOOGLE_CLIENT_IDS=
