# Android emulator defaults to http://10.0.2.2:8000/api.
# For a physical phone, use your computer's LAN IP; use HTTPS in production.
# EXPO_PUBLIC_API_BASE=http://192.168.1.42:8000/api
# Optional separate API address for Expo web on the development computer.
# EXPO_PUBLIC_WEB_API_BASE=http://127.0.0.1:8000/api

# Public OAuth client IDs (never put a client secret in this file).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Public website origin used when opening or sharing verification links.
EXPO_PUBLIC_WEB_BASE=https://credence.edu.sl
