{
  "expo": {
    "name": "Intelligent Academic Credentialing",
    "slug": "credence",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "credence",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.credence.app"
    },
    "android": {
      "package": "com.credence.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#08283F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "credence"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": []
    },
    "web": {
      "favicon": "./assets/fav.png",
      "name": "Intelligent Academic Credentialing",
      "shortName": "Intelligent Academic Credentialing",
      "description": "Blockchain-backed academic certificate verification"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Credence to scan credential QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Credence to select credential QR images.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "backgroundColor": "#08283F",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d83b8108-a548-4024-bb97-c9af3b6fddff"
      }
    },
    "owner": "samjrabel"
  }
}
